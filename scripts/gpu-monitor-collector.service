[Unit]
Description=GPU Monitor Collector
After=network.target
Wants=network.target

[Service]
Type=simple
User=nobody
Group=nogroup
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/gpu-monitor/collector.env
ExecStart=/usr/local/bin/gpu-monitor-collector
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gpu-monitor-collector

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
