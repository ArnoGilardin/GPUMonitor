# ============================================================================
# GPU Monitor Collector - Environment Configuration
# ============================================================================
# IMPORTANT: Copy to .env and fill with actual values for your deployment.
# ============================================================================

# ----------------------------------------------------------------------------
# Central API Configuration
# ----------------------------------------------------------------------------
# URL of your central GPU Monitor API
# Examples:
#   - Production: https://gpu-monitor.your-domain.com
#   - Local network: http://192.168.1.100:5100
#   - Development: http://localhost:5100
CENTRAL_API_URL=https://your-monitor.domain.com

# API Key for authentication (must match COLLECTOR_API_KEY on server)
# Get this from your server's .env file or generate with: openssl rand -hex 24
CENTRAL_API_KEY=CHANGE_ME_COLLECTOR_KEY

# ----------------------------------------------------------------------------
# Server Identification
# ----------------------------------------------------------------------------
# Unique identifier for this server (alphanumeric, hyphens, underscores)
# Examples: z620-gpu-01, ml-server-prod, render-node-05
SERVER_ID=my-gpu-server-01

# Human-readable name for this server
SERVER_NAME=My GPU Server 01

# Comma-separated tags for filtering/grouping
# Examples: gpu,production,ml,rendering,z620,nvidia
SERVER_TAGS=gpu,production

# ----------------------------------------------------------------------------
# Collection Settings
# ----------------------------------------------------------------------------
# How often to collect and send metrics (in seconds)
# Recommended: 30 (balance between real-time data and load)
# Range: 10-300
INTERVAL_SEC=30

# ----------------------------------------------------------------------------
# Optional: Advanced Settings
# ----------------------------------------------------------------------------
# Override automatic hostname detection (usually not needed)
# HOSTNAME=custom-hostname
