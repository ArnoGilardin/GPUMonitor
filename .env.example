# ============================================================================
# GPU Monitor - Environment Configuration
# ============================================================================
# IMPORTANT: This is an example file. Copy to .env and fill with actual values.
# NEVER commit .env file with real secrets to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
# Environment: development, production
NODE_ENV=production

# Port for the application (internal Docker port)
# Default: 5100 (avoid conflicts with common ports like 5000, 8000)
PORT=5100

# Trust proxy headers (set to true when behind Nginx/Caddy)
TRUST_PROXY=true

# Frontend URL for CORS in production (your public domain)
FRONTEND_URL=https://your-domain.com

# ----------------------------------------------------------------------------
# Database Configuration - PostgreSQL
# ----------------------------------------------------------------------------
# SECURITY: Generate a strong password for production!
# Command: openssl rand -base64 32

# Full connection string (recommended for Docker)
DATABASE_URL=postgresql://gpumonitor:CHANGE_ME_DB_PASSWORD@postgres:5432/gpu_monitor

# Individual connection parameters (alternative)
PGHOST=postgres
PGPORT=5432
PGDATABASE=gpu_monitor
PGUSER=gpumonitor
PGPASSWORD=CHANGE_ME_DB_PASSWORD

# ----------------------------------------------------------------------------
# Security Secrets
# ----------------------------------------------------------------------------
# CRITICAL: Generate strong random secrets for production!
# Commands to generate:
#   JWT_SECRET:            openssl rand -hex 32
#   REFRESH_TOKEN_SECRET:  openssl rand -hex 32
#   COLLECTOR_API_KEY:     openssl rand -hex 24

# JWT token secret (for access tokens - 15 min expiry)
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Refresh token secret (for refresh tokens - 7 days expiry)
REFRESH_TOKEN_SECRET=CHANGE_ME_REFRESH_SECRET

# Global collector key. Collectors using it register their server automatically.
# Servers added from the UI get their own key instead (recommended).
COLLECTOR_API_KEY=CHANGE_ME_COLLECTOR_KEY

# true = refuse the global key, only accept per-server keys created in the UI
REQUIRE_SERVER_KEYS=false

# Password hashing rounds (10-12 recommended, higher = slower but more secure)
BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Admin Account
# ----------------------------------------------------------------------------
# CRITICAL: Change these before first deployment!
# Admin account is created automatically on first run (empty database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Allow anyone to create a (viewer) account from the login page.
# Admins can always create accounts in Settings > Users.
ALLOW_REGISTRATION=false

# ----------------------------------------------------------------------------
# Email Notifications (SendGrid)
# ----------------------------------------------------------------------------
# Get your API key from: https://app.sendgrid.com/settings/api_keys
# Leave empty to disable email notifications
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@your-domain.com

# ----------------------------------------------------------------------------
# Alert recipients, webhook (Slack/Discord/...), offline delay and data
# retention are configured in the web UI (Settings).
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
# Max /api requests per IP per window (the dashboard polls several endpoints)
RATE_LIMIT_MAX_REQUESTS=3000

# Max ingest requests per minute per collector key and IP
RATE_LIMIT_INGEST_MAX=120

# ----------------------------------------------------------------------------
# Database schema
# ----------------------------------------------------------------------------
# The Docker image runs `drizzle-kit push` at startup. Set to false to manage
# the schema yourself (npm run db:push).
DB_AUTO_MIGRATE=true

# Host port the app is published on (bound to 127.0.0.1)
APP_PORT=5100

# ----------------------------------------------------------------------------
# PostgreSQL Configuration (for docker-compose)
# ----------------------------------------------------------------------------
# These match the DATABASE_URL components above
POSTGRES_DB=gpu_monitor
POSTGRES_USER=gpumonitor
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
