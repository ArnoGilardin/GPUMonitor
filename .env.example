# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gpu_monitor

# PostgreSQL Direct Connection (alternative to DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=gpu_monitor
PGUSER=postgres
PGPASSWORD=postgres

# Application Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
COLLECTOR_API_KEY=your-collector-api-key-change-this

# Email Notifications (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=alerts@your-domain.com

# Server Configuration
NODE_ENV=development
PORT=5000
TRUST_PROXY=false

# Frontend URL (for CORS in production)
FRONTEND_URL=https://your-domain.com

# Optional: Admin User (for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-password-change-this

# Alert Configuration Defaults
DEFAULT_ALERT_EMAIL=admin@your-domain.com
DEFAULT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Collection Settings
DEFAULT_COLLECTION_INTERVAL=30
HIGH_FREQUENCY_INTERVAL=10

# Data Retention (in days)
METRICS_RETENTION_DAYS=30
ALERTS_RETENTION_DAYS=90
LOGS_RETENTION_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_INGEST_MAX=120

# Security
SESSION_SECRET=your-session-secret-key
BCRYPT_ROUNDS=12
